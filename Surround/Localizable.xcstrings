          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "另外，还有 %lld 个符合您偏好设置的公开自定义对局，接受后即可立即开始对局。"
