    "Tap and drag to place a stone. Drag outside of the board to cancel." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe und ziehe, um einen Stein zu setzen. Ziehe zum Abbrechen über den Brettrand hinaus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca y arrastra para colocar una piedra. Arrástrala fuera del tablero para cancelar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
