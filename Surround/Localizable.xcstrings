    " — players may drop mid-game" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — Spieler können während der Partie aussteigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — los jugadores pueden retirarse durante la partida"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- les participants peuvent quitter pendant la partie"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ー　プレーヤーは、途中でも対局を抜けられます。"
