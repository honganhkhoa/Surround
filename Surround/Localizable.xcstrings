{
  "sourceLanguage" : "en",
  "strings" : {
    " — players may drop mid-game" : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "- les participants peuvent quitter pendant la partie"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ー　プレーヤーは、途中でも対局を抜けられます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — 대국 도중에 플레이어가 나갈 수 있습니다"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — người chơi có thể bỏ cuộc giữa chừng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — 对局中途允许玩家退出"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — 玩家可在對局途中退出"
          }
        }
      }
    },
