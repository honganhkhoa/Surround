    "Alternatively, there are %lld open custom games matching your preferences that you can accept to start a game immediately." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alternatively, there is %lld open custom game matching your preferences that you can accept to start a game immediately."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "Alternatively, there are %lld open custom games matching your preferences that you can accept to start a game immediately."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Il y a également %lld partie ouverte correspondant à vos préférences que vous pouvez accepter pour commencer une partie immédiatement."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Il y a également %lld parties ouvertes correspondant à vos préférences que vous pouvez accepter pour commencer une partie immédiatement."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "それとも、あなたの設定に合った対局は%lld局があります。受ければすぐ始まります。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
