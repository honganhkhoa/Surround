            }
          }
        },
        "vi" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Hoặc có %lld ván đang chờ bên dưới phù hợp với tuỳ chọn của bạn, có thể chấp nhận để bắt đầu ván ngay lập tức."
