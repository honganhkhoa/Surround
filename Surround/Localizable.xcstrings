    "Private messages are only stored for a few days, so please make sure to save any important information somewhere else." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les messages privés ne sont stockés que pour quelques jours, alors assurez-vous d'enregistrer toute information importante ailleurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プライベートメッセージは数日しか保存されませんので、重要な情報がありましたら、別の所にセーブして下さい。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개인 메시지는 며칠 동안만 보관되므로 중요한 내용은 다른 곳에 저장해 주세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tin nhắn riêng chỉ được giữ trong vài ngày, nên nếu có thông tin gì cần lưu lại bạn cần ghi lại ở chỗ khác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私信只会保留数日，请务必将重要信息另行保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "私人訊息只會保留幾天，請務必將任何重要資訊儲存在其他地方。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Private Nachrichten werden nur wenige Tage gespeichert. Sichere wichtige Informationen daher bitte an einem anderen Ort."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ข้อความส่วนตัวจะเก็บไว้เพียงไม่กี่วัน โปรดบันทึกข้อมูลสำคัญไว้ที่อื่น"
          }
        }
      }
    },
