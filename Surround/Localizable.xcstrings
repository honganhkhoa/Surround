    "Tap and drag to place a stone. Drag outside of the board to cancel." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez et faites glisser pour placer une pierre. Glissez jusqu'à l'extérieur du plateau pour annuler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップとドラッグで石を置けられます。碁盤外までドラッグすることで、キャンセルが出来ます。"
