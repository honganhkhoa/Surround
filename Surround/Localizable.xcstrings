        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — 对局中途允许玩家退出"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " — 玩家可在對局途中退出"
