    "Sign in to your online-go.com account to see your games here." : {
      "comment" : "Correspondence Games Widget error",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melde dich bei deinem online-go.com-Konto an, um deine Partien hier zu sehen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia sesión en tu cuenta de online-go.com para ver aquí tus partidas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez-vous à votre compte OGS pour voir vos parties ici."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "online-go.comのアカウントにロギンすれば、ここに対局リストが表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기서 대국을 보려면 online-go.com 계정에 로그인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
