    "Add your preferred game settings to create a game with the exact settings you want faster." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge deine bevorzugten Partieeinstellungen hinzu, um schneller eine Partie genau nach deinen Wünschen zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade tus configuraciones de partida preferidas para crear más rápido una partida exactamente como quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez vos paramètres de partie préférés pour créer plus rapidement une partie avec les réglages exacts que vous voulez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "よく使う対局設定を追加しておくと、希望どおりの設定でより素早く対局を作成できます。"
