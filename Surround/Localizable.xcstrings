    "Alternatively, there are %lld open custom games matching your preferences that you can accept to start a game immediately." : {
      "localizations" : {
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alternativ gibt es %lld offene benutzerdefinierte Partie, die deinen Einstellungen entspricht und die du annehmen kannst, um sofort zu spielen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
