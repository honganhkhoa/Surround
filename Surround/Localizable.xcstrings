          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 구매는 최종 확정되며, Apple ID로 결제된 구매는 제가 환불해 드릴 수 없습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
