{
  "sourceLanguage" : "en",
  "strings" : {
    "Opening game…" : {
      "comment" : "Accessible loading state shown while a deep-linked game is fetched",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partie wird geöffnet …"
          }
        },
        "es" : {
