          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Benutzerdefinierte** Brettgrößen sind in **gewerteten** Partien nicht verfügbar."
          }
        },
        "th" : {
          "stringUnit" : {
