    "Alternatively, there are %lld open custom games matching your preferences that you can accept to start a game immediately." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alternatively, there is %lld open custom game matching your preferences that you can accept to start a game immediately."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "new",
                  "value" : "Alternatively, there are %lld open custom games matching your preferences that you can accept to start a game immediately."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Il y a également %lld partie ouverte correspondant à vos préférences que vous pouvez accepter pour commencer une partie immédiatement."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Il y a également %lld parties ouvertes correspondant à vos préférences que vous pouvez accepter pour commencer une partie immédiatement."
                }
              }
            }
          }
        },
        "ja" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "それとも、あなたの設定に合った対局は%lld局があります。受ければすぐ始まります。"
                }
              }
            }
          }
        },
        "ko" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "또는 선호 설정과 일치하는 공개 맞춤 대국 %lld국을 수락해 바로 시작할 수 있습니다."
                }
              }
            }
          }
        },
        "vi" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Hoặc có %lld ván đang chờ bên dưới phù hợp với tuỳ chọn của bạn, có thể chấp nhận để bắt đầu ván ngay lập tức."
                }
              }
            }
          }
        },
        "zh-Hans" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "另外，还有 %lld 个符合您偏好设置的公开自定义对局，接受后即可立即开始对局。"
                }
              }
            }
          }
        },
        "zh-Hant" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "另外，目前有 %lld 場符合你偏好的公開自訂對局，接受後即可開始。"
                }
              }
            }
          }
        },
        "de" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alternativ gibt es %lld offene benutzerdefinierte Partie, die deinen Einstellungen entspricht und die du annehmen kannst, um sofort zu spielen."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Alternativ gibt es %lld offene benutzerdefinierte Partien, die deinen Einstellungen entsprechen und die du annehmen kannst, um sofort zu spielen."
                }
              }
            }
          }
        },
        "th" : {
          "variations" : {
            "plural" : {
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "อีกทางหนึ่ง มีเกมกำหนดเองแบบเปิด %lld เกมที่ตรงกับความต้องการของคุณ ซึ่งคุณยอมรับเพื่อเริ่มเล่นได้ทันที"
                }
              }
            }
          }
        }
      }
    },
