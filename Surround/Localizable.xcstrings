        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重试"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再試一次"
          }
        }
      }
    },
    "The game may have ended or could not be loaded. Please try again." : {
      "comment" : "Explains why a deep-linked game could not be opened",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Partie ist möglicherweise beendet oder konnte nicht geladen werden. Versuche es bitte erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que la partida haya terminado o que no se haya podido cargar. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partie est peut-être terminée ou n’a pas pu être chargée. Veuillez réessayer."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対局が終了したか、読み込めなかった可能性があります。もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "대국이 종료되었거나 불러오지 못했을 수 있습니다. 다시 시도해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partida pode ter terminado ou talvez não tenha sido possível carregá-la. Tente novamente."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A partida pode ter terminado ou não ter sido possível carregá-la. Tente novamente."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เกมอาจจบลงแล้วหรือไม่สามารถโหลดได้ โปรดลองอีกครั้ง"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ván đấu có thể đã kết thúc hoặc không tải được. Vui lòng thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对局可能已结束或无法加载。请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對局可能已結束或無法載入。請再試一次。"
          }
        }
      }
    },
