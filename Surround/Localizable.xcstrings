    "**Live games** generally finish in one sitting, around 30 seconds per move, or 10 seconds per move in **Blitz** mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**Live-Partien** enden normalerweise in einer Sitzung, mit ungefähr 30 Sekunden pro Zug oder 10 Sekunden pro Zug im **Blitzmodus**."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las **partidas en vivo** suelen terminarse en una sola sesión, con unos 30 segundos por jugada, o 10 segundos por jugada en el modo **Blitz**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une **partie en temps réel** se termine en général en une session, au rythme de 30 secondes par coup, ou 10 en mode **Blitz**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**ライブ対局** ：普段1 手 30 秒前後で、**ブリッツ**の場合、1 手 10 秒前後。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**실시간 대국**은 보통 한 수에 약 30초, **초속기**에서는 약 10초로 한 번에 끝납니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As **partidas ao vivo** geralmente terminam em uma única sessão, com cerca de 30 segundos por jogada ou 10 segundos por jogada no modo **Blitz**."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As **partidas em direto** terminam numa só sessão: cerca de 30 segundos por jogada, ou 10 no modo **Blitz**."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**เกมสด** มักเล่นจบในครั้งเดียว โดยใช้เวลาราว 30 วินาทีต่อตา หรือ 10 วินาทีต่อตาในโหมด **บลิตซ์**"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thời gian cho mỗi **ván trực tiếp** thường khoảng 30 giây mỗi nước, hoặc 10 giây mỗi nước nếu chọn chế độ **cờ chớp**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**即时对局**通常会一次完成，每手约 30 秒；在**闪电**模式下，每手约 10 秒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "**即時對局**通常會一次下完，每手約 30 秒；**快棋**模式則每手約 10 秒。"
          }
        }
      }
    },
