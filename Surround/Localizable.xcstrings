        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "感谢 [**Raphaël Assenat**](https:\/\/www.raphnet.net\/index_en.php) 推动本应用的多语言翻译工作，并完成日语翻译。"
