        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona los tamaños de tablero y la configuración de tiempo que prefieras, y deja que el sistema te empareje con otro jugador de rango similar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les dimensions du plateau et les paramètres de temps que vous désirez puis laissez le système vous trouver un adversaire de niveau similaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ご希望の碁盤の大きさと時間制限方式で、ランクが近い対戦相手をシステムに探してもらえます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "원하는 바둑판 크기와 시간 설정을 선택하면 시스템이 비슷한 기력의 상대와 연결해 줍니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione os tamanhos de tabuleiro e as configurações de tempo que deseja jogar e deixe o sistema encontrar outro jogador com classificação semelhante."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escolha os tamanhos de tabuleiro e as definições de tempo; o sistema encontra outro jogador de nível semelhante."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เลือกขนาดกระดานและการตั้งค่าเวลาที่ต้องการ แล้วให้ระบบจับคู่คุณกับผู้เล่นที่มีระดับฝีมือใกล้เคียงกัน"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chọn kích thước bàn cờ và chế độ thời gian bạn muốn chơi, sau đó hệ thống sẽ tự động tìm cho bạn một đối thủ ở đẳng cấp tương đương."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择您想使用的棋盘尺寸和用时设置，系统会为您匹配一位棋力相近且偏好相似的棋手。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇想要的棋盤尺寸與時間設定，系統會為你配對棋力相近且偏好相似的玩家。"
          }
        }
      }
    },
