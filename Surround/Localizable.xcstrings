    "All purchases are final. I cannot issue refunds for purchases charged to your Apple ID." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les achats sont finaux. Je ne peux pas rembourser les achats effectués avec votre Apple ID."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "全てのご購入はキャンセルが出来ません。お客様のApple Accountへの返金ができかねます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 구매는 최종 확정되며, Apple ID로 결제된 구매는 제가 환불해 드릴 수 없습니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiền hỗ trợ một khi đã thanh toán không thể hoàn trả được, vì Surround không hoàn trả được giao dịch bằng tài khoản Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有购买均为最终交易。对于已从您的 Apple ID 扣款的购买，我无法办理退款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有購買均為最終交易。對於已向你 Apple ID 收取的費用，我無法辦理退款。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Käufe sind endgültig. Für Käufe, die deiner Apple-ID belastet wurden, kann ich keine Erstattung veranlassen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การซื้อทั้งหมดถือเป็นที่สิ้นสุด ฉันไม่สามารถคืนเงินสำหรับรายการที่เรียกเก็บผ่าน Apple ID ของคุณได้"
          }
        }
      }
    },
