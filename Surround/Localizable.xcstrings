    "Clock starts with **%@** and increases by **%@** per move, up to a maximum of **%@**." : {
      "comment" : "TimeControl - long description for fischer system",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Clock starts with **%1$@** and increases by **%2$@** per move, up to a maximum of **%3$@**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'horloge commence avec **%1$@** et augmente de **%2$@** par coup, jusqu'à un maximum de **%3$@**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "持ち時間**%1$@**,一手ごとに**%2$@**加算、**%3$@**まで。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계는 **%1$@**에서 시작해 매 수 **%2$@**씩 늘어나며, 최대 **%3$@**까지 증가합니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bắt đầu với **%1$@** và tăng thêm **%2$@** sau mỗi nước cho tới tối đa **%3$@**."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时钟以 **%1$@** 开始，每手增加 **%2$@**，最多累计到 **%3$@**。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計時從 **%1$@** 開始，每手增加 **%2$@**，最多至 **%3$@**。"
          }
        }
      }
    },
    "Clock starts with **%@** main time, follows by **%@** for every **%lld moves**." : {
      "comment" : "TimeControl - long description for Canadian byo-yomi system",
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Clock starts with **%1$@** main time, follows by **%2$@** for every **%3$lld move**."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "Clock starts with **%1$@** main time, follows by **%2$@** for every **%3$lld moves**."
                }
              }
            }
          }
        },
        "fr" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "L'horloge commence avec un temps principal de **%1$@**, et ensuite **%2$@** pour **%3$lldcoup**."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "L'horloge commence avec un temps principal de **%1$@**, et ensuite **%2$@** pour **%3$lldcoups**."
