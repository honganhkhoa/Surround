    "Tap and drag to place a stone. Drag outside of the board to cancel." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez et faites glisser pour placer une pierre. Glissez jusqu'à l'extérieur du plateau pour annuler."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップとドラッグで石を置けられます。碁盤外までドラッグすることで、キャンセルが出来ます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "돌을 놓으려면 탭한 채 드래그하세요. 취소하려면 바둑판 밖으로 드래그하세요."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm và kéo để đặt quân cờ. Kéo ra khỏi bàn cờ để huỷ thao tác."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点按并拖动以放置棋子；拖到棋盘外即可取消。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點住並拖曳以放置棋子。將棋子拖到棋盤外即可取消。"
          }
        }
      }
    },
    "Tap on avatars to assign players into teams." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
