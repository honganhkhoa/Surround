    "Malkovich log is hidden from your opponent during game, and always visible to you and observers." : {
      "localizations" : {
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le journal Malkovich est invisible pour l'adversaire pendant la partie et visible en tout temps pour vous et les spectateurs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモ(対局相手に非公開)。対局終了後に閲覧可。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말코비치 기록은 대국 중 상대에게 보이지 않으며, 나와 관전자에게는 항상 표시됩니다."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi chú Malkovich sau khi hết trận đối thủ mới xem được."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对局期间，留言记录对您的对手不可见，但您和观战者始终可以查看。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malkovich 紀錄在對局期間不會顯示給你的對手，但你與觀戰者隨時都能看到。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Malkovich-Protokoll bleibt während der Partie vor deinem Gegner verborgen und ist für dich und Zuschauer immer sichtbar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บันทึก Malkovich จะซ่อนจากคู่แข่งระหว่างเกม และคุณกับผู้ชมจะมองเห็นได้เสมอ"
          }
        }
      }
    },
