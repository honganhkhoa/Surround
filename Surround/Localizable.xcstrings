          "stringUnit" : {
            "state" : "translated",
            "value" : "Surroundは、オンライン囲碁対局「Online-go.com」（いわゆる「OGS」）と言うWEBサイトのクライアントです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surround는 Online Go Server(OGS)라고도 하는 Online-Go.com에서 다른 플레이어와 온라인 바둑을 두는 클라이언트입니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Surround é um cliente para jogar Go online com outros jogadores no site Online-Go.com, também conhecido como Online Go Server (OGS)."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Surround é um cliente para jogar Go online com outros jogadores no site Online-Go.com, também conhecido como Online Go Server (OGS)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surround เป็นไคลเอนต์สำหรับเล่นหมากล้อมออนไลน์กับผู้เล่นอื่นบนเว็บไซต์ Online-Go.com หรือที่รู้จักในชื่อ Online Go Server (OGS)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surround là ứng dụng để chơi Cờ Vây trên mạng với những kì thủ khác trên website Onine-Go.com (Online Go Server - OGS)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surround 是一款 Online-Go.com 客户端，可让您在线与其他棋手下围棋。该网站也称为 Online Go Server（OGS）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Surround 是一款圍棋用戶端，讓你能在 Online-Go.com（亦稱 Online Go Server，簡稱 OGS）上與其他玩家線上對弈。"
          }
        }
      }
    },
