    "Note: Sounds and voice countdown will not play when your device is in **Silent** mode." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hinweis: Töne und der Sprach-Countdown werden nicht wiedergegeben, wenn sich dein Gerät im Modus **Stumm** befindet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: Los sonidos y la cuenta regresiva por voz no se reproducirán cuando el dispositivo esté en modo **Silencio**."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attention: Les sons et le compte à rebours seront inaudibles si votre appareil est en mode **silencieux**."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "※**マナー・モード**がONの時、石音や音声が出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "참고: 기기가 **무음** 모드이면 효과음과 음성 초읽기가 재생되지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observação: os sons e a contagem regressiva por voz não serão reproduzidos quando o dispositivo estiver no modo **Silencioso**."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nota: os sons e a contagem decrescente por voz não serão reproduzidos quando o dispositivo estiver no modo **Sem som**."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หมายเหตุ: เสียงและเสียงนับถอยหลังจะไม่เล่นเมื่ออุปกรณ์อยู่ในโหมด **ปิดเสียง**"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ghi chú: khi thiết bị đang trong chế độ **im lặng** sẽ không phát tiếng quân cờ và tiếng đếm ngược."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
